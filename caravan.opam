# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Verifier of multicore OCaml programs, built on Raven"
description:
  "Caravan verifies multicore OCaml programs by translating them, with their specifications, to the Raven verifier."
maintainer: ["Thomas Wies"]
authors: ["Thomas Wies"]
license: "MIT"
homepage: "https://github.com/nyu-acsys/caravan"
bug-reports: "https://github.com/nyu-acsys/caravan/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.12" & >= "3.12"}
  "raven" {>= "1.5.0"}
  "ocamlformat" {with-dev-setup & >= "0.29.0"}
  "base" {>= "0.14"}
  "stdio" {>= "0.14"}
  "logs" {>= "0.7.0"}
  "fmt" {>= "0.9.0"}
  "cmdliner" {>= "1.2.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/nyu-acsys/caravan.git"
