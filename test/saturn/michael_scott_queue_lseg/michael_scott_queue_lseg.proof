type edge = Edge of node Atomic.t * int * node Atomic.t

predicate segment (first : node Atomic.t) (limit : node Atomic.t)
    (items [@implicit] : int list) (cells [@implicit] : node Atomic.t finset)
    (edges [@implicit] : edge finset) =
  not (Finset.mem limit cells)
  && (match items with
      | [] -> first == limit && cells = Finset.empty && edges = Finset.empty
      | value :: tail ->
          exists next : node Atomic.t, tail_cells : node Atomic.t finset,
            tail_edges : edge finset.
          first != limit && not (Finset.mem first tail_cells)
          && cells = Finset.union (Finset.singleton first) tail_cells
          && edges = Finset.union (Finset.singleton (Edge (first, value, next))) tail_edges
          && own first (Next (value, next))
          && segment next limit tail tail_cells tail_edges)

lemma segment_info (first : node Atomic.t) (limit : node Atomic.t)
    (items [@implicit] : int list) (cells [@implicit] : node Atomic.t finset)
    (edges [@implicit] : edge finset)
  requires (segment first limit items cells edges)
  ensures (segment first limit items cells edges)
  ensures (not (Finset.mem limit cells))
  ensures (items = [] -> first == limit && cells = Finset.empty && edges = Finset.empty)
  ensures (items <> [] -> Finset.mem first cells && first != limit) =
  let (next, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  fold segment first limit items cells edges {next = next; tail_cells = tail_cells;
    tail_edges = tail_edges}

lemma segment_join (first : node Atomic.t) (middle : node Atomic.t)
    (limit : node Atomic.t) (left : int list) (right : int list)
    (left_cells : node Atomic.t finset) (right_cells : node Atomic.t finset)
    (left_edges : edge finset) (right_edges : edge finset)
  requires (segment first middle left left_cells left_edges
    && segment middle limit right right_cells right_edges)
  requires (Finset.inter left_cells right_cells = Finset.empty)
  requires (not (Finset.mem limit left_cells))
  ensures (segment first limit (left @ right)
    (Finset.union left_cells right_cells) (Finset.union left_edges right_edges))
  variant (left) =
  segment_info middle limit;
  let (next, tail_cells, tail_edges) =
    unfold segment first middle left left_cells left_edges {next; tail_cells; tail_edges} in
  match left with
  | [] -> ()
  | value :: tail ->
      segment_join next middle limit tail right tail_cells right_cells tail_edges right_edges;
      fold segment first limit (left @ right)
        (Finset.union left_cells right_cells) (Finset.union left_edges right_edges)
        {next = next; tail_cells = Finset.union tail_cells right_cells;
          tail_edges = Finset.union tail_edges right_edges}

lemma segment_append (first : node Atomic.t) (limit : node Atomic.t)
    (successor : node Atomic.t) (items : int list)
    (cells : node Atomic.t finset) (edges : edge finset) (value : int)
  requires (segment first limit items cells edges && own limit (Next (value, successor)))
  requires (successor != limit && not (Finset.mem successor cells))
  ensures (segment first successor (items @ [value])
    (Finset.union cells (Finset.singleton limit))
    (Finset.union edges (Finset.singleton (Edge (limit, value, successor))))) =
  segment_info first limit;
  fold segment successor successor [] Finset.empty Finset.empty;
  fold segment limit successor [value] (Finset.singleton limit)
    (Finset.singleton (Edge (limit, value, successor)))
    {next = successor; tail_cells = Finset.empty; tail_edges = Finset.empty};
  segment_join first limit successor items [value] cells (Finset.singleton limit)
    edges (Finset.singleton (Edge (limit, value, successor)))

lemma segment_split (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
    (target : node Atomic.t)
  returns (before : int list) (before_cells : node Atomic.t finset)
    (before_edges : edge finset) (value : int) (next : node Atomic.t)
    (after : int list) (after_cells : node Atomic.t finset) (after_edges : edge finset)
  requires (segment first limit items cells edges && Finset.mem target cells)
  ensures (segment first target before before_cells before_edges
    && own target (Next (value, next)) && segment next limit after after_cells after_edges)
  ensures (items = before @ (value :: after))
  ensures (cells = Finset.union before_cells (Finset.union (Finset.singleton target) after_cells))
  ensures (edges = Finset.union before_edges
    (Finset.union (Finset.singleton (Edge (target, value, next))) after_edges))
  ensures (Finset.inter before_cells after_cells = Finset.empty)
  ensures (not (Finset.mem target before_cells) && not (Finset.mem target after_cells))
  ensures (target != limit && not (Finset.mem limit before_cells))
  variant (items) =
  let (successor, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  match items with
  | [] -> assert false
  | head :: tail ->
      if first == target then begin
        fold segment first target [] Finset.empty Finset.empty;
        ([], Finset.empty, Finset.empty, head, successor, tail, tail_cells, tail_edges)
      end else begin
        let (prefix, prefix_cells, prefix_edges, value, next, after, after_cells, after_edges) =
          segment_split successor limit tail tail_cells tail_edges target in
        fold segment first target (head :: prefix)
          (Finset.union (Finset.singleton first) prefix_cells)
          (Finset.union (Finset.singleton (Edge (first, head, successor))) prefix_edges)
          {next = successor; tail_cells = prefix_cells; tail_edges = prefix_edges};
        (head :: prefix, Finset.union (Finset.singleton first) prefix_cells,
          Finset.union (Finset.singleton (Edge (first, head, successor))) prefix_edges,
          value, next, after, after_cells, after_edges)
      end

lemma segment_restore (first : node Atomic.t) (target : node Atomic.t)
    (next : node Atomic.t) (limit : node Atomic.t) (before : int list) (after : int list)
    (before_cells : node Atomic.t finset) (after_cells : node Atomic.t finset)
    (before_edges : edge finset) (after_edges : edge finset) (value : int)
  requires (segment first target before before_cells before_edges
    && own target (Next (value, next)) && segment next limit after after_cells after_edges)
  requires (Finset.inter before_cells after_cells = Finset.empty
    && not (Finset.mem target before_cells) && not (Finset.mem target after_cells)
    && not (Finset.mem limit before_cells) && target != limit)
  ensures (segment first limit (before @ (value :: after))
    (Finset.union before_cells (Finset.union (Finset.singleton target) after_cells))
    (Finset.union before_edges
      (Finset.union (Finset.singleton (Edge (target, value, next))) after_edges))) =
  segment_info next limit;
  fold segment target limit (value :: after)
    (Finset.union (Finset.singleton target) after_cells)
    (Finset.union (Finset.singleton (Edge (target, value, next))) after_edges)
    {next = next; tail_cells = after_cells; tail_edges = after_edges};
  segment_join first target limit before (value :: after) before_cells
    (Finset.union (Finset.singleton target) after_cells) before_edges
    (Finset.union (Finset.singleton (Edge (target, value, next))) after_edges)

lemma segment_round_trip (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
    (target : node Atomic.t)
  requires (segment first limit items cells edges && Finset.mem target cells)
  ensures (segment first limit items cells edges) =
  let (before, before_cells, before_edges, value, next, after, after_cells, after_edges) =
    segment_split first limit items cells edges target in
  segment_restore first target next limit before after before_cells after_cells
    before_edges after_edges value

lemma segment_edge_endpoints (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
  requires (segment first limit items cells edges)
  ensures (segment first limit items cells edges)
  ensures (forall edge : edge. Finset.mem edge edges ->
    match edge with Edge (source, _, destination) ->
      Finset.mem source cells && (Finset.mem destination cells || destination == limit))
  variant (items) =
  let (next, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  match items with
  | [] -> fold segment first limit items cells edges
  | _ :: tail ->
      segment_info next limit;
      segment_edge_endpoints next limit tail tail_cells tail_edges;
      fold segment first limit items cells edges {next = next; tail_cells = tail_cells;
        tail_edges = tail_edges}

lemma segment_edges_functional (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
  requires (segment first limit items cells edges)
  ensures (segment first limit items cells edges)
  ensures (forall a : edge, b : edge. Finset.mem a edges && Finset.mem b edges ->
    match a with Edge (source_a, _, _) ->
      match b with Edge (source_b, _, _) -> source_a == source_b -> a = b)
  variant (items) =
  let (next, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  match items with
  | [] -> fold segment first limit items cells edges
  | _ :: tail ->
      segment_edge_endpoints next limit tail tail_cells tail_edges;
      segment_edges_functional next limit tail tail_cells tail_edges;
      fold segment first limit items cells edges {next = next; tail_cells = tail_cells;
        tail_edges = tail_edges}

lemma segment_terminal_outside (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
    (terminal : node Atomic.t)
  requires (segment first limit items cells edges && own terminal Nil)
  ensures (segment first limit items cells edges && own terminal Nil)
  ensures (not (Finset.mem terminal cells))
  variant (items) =
  let (next, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  match items with
  | [] -> fold segment first limit items cells edges
  | _ :: tail ->
      assert (first != terminal);
      segment_terminal_outside next limit tail tail_cells tail_edges terminal;
      fold segment first limit items cells edges {next = next; tail_cells = tail_cells;
        tail_edges = tail_edges}

lemma consecutive_segment_edges (first : node Atomic.t) (middle : node Atomic.t)
    (limit : node Atomic.t) (left : int list) (right : int list)
    (left_cells : node Atomic.t finset) (right_cells : node Atomic.t finset)
    (left_edges : edge finset) (right_edges : edge finset)
  requires (segment first middle left left_cells left_edges
    && segment middle limit right right_cells right_edges)
  requires (Finset.inter left_cells right_cells = Finset.empty)
  ensures (segment first middle left left_cells left_edges
    && segment middle limit right right_cells right_edges)
  ensures (forall a : edge, b : edge.
    Finset.mem a (Finset.union left_edges right_edges)
    && Finset.mem b (Finset.union left_edges right_edges) ->
      match a with Edge (source_a, _, _) ->
        match b with Edge (source_b, _, _) -> source_a == source_b -> a = b)
  ensures (forall edge : edge. Finset.mem edge (Finset.union left_edges right_edges) ->
    match edge with Edge (source, _, destination) ->
      Finset.mem source (Finset.union left_cells right_cells)
      && (Finset.mem destination (Finset.union left_cells right_cells)
        || destination == middle || destination == limit)) =
  segment_edge_endpoints first middle left left_cells left_edges;
  segment_edge_endpoints middle limit right right_cells right_edges;
  segment_edges_functional first middle left left_cells left_edges;
  segment_edges_functional middle limit right right_cells right_edges

lemma list_append_assoc (a : int list) (b : int list) (c : int list)
  ensures ((a @ b) @ c = a @ (b @ c))
  variant (a) =
  match a with
  | [] -> ()
  | _ :: tail -> list_append_assoc tail b c

type exposed_cell =
  | At_last
  | Retired_cell of int list * node Atomic.t finset * edge finset
      * int * node Atomic.t * int list * node Atomic.t finset * edge finset
  | Active_cell of int list * node Atomic.t finset * edge finset
      * int * node Atomic.t * int list * node Atomic.t finset * edge finset

type empty_observation =
  | Observed_link of edge
  | Waiting_on of Ghost.t

type fact =
  | Published of node Atomic.t
  | Linked of edge
  | Head_seen of node Atomic.t
  | Registered of Ghost.t

module Facts = SetRA (struct type t = fact end)
module Fact_auth = Auth (Facts)

let facts_auth : (node Atomic.t Atomic.t, Fact_auth.t) Ghost.field = Ghost.field ()
let view_queue : (node Atomic.t Atomic.t, int list) Ghost.field = Ghost.field ()

module Empty = Ghost.AU (struct let operation = is_empty end)
module Push = Ghost.AU (struct let operation = push end)
module Pop = Ghost.AU (struct let operation = pop_as end)
module PopOpt = Ghost.AU (struct let operation = pop_opt end)

let facts_of (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset) : fact set =
  Set.of_predicate (fun (f : fact) ->
    match f with
    | Published cell -> Finset.mem cell published
    | Linked edge -> Finset.mem edge links
    | Head_seen cell -> Finset.mem cell seen
    | Registered reg -> Finset.mem reg waiting)

lemma published_fact (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset)
    (cell : node Atomic.t)
  requires (Finset.mem cell published)
  ensures (Set.mem (Published cell) (facts_of published links seen waiting)) = ()

lemma linked_fact (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset) (link : edge)
  requires (Finset.mem link links)
  ensures (Set.mem (Linked link) (facts_of published links seen waiting)) = ()

lemma head_fact (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset)
    (cell : node Atomic.t)
  requires (Finset.mem cell seen)
  ensures (Set.mem (Head_seen cell) (facts_of published links seen waiting)) = ()

lemma registration_fact (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset) (reg : Ghost.t)
  requires (Finset.mem reg waiting)
  ensures (Set.mem (Registered reg) (facts_of published links seen waiting)) = ()

lemma facts_grow (before_pub : node Atomic.t finset)
    (after_pub : node Atomic.t finset) (before_links : edge finset)
    (after_links : edge finset) (before_seen : node Atomic.t finset)
    (after_seen : node Atomic.t finset) (before_waiting : Ghost.t finset)
    (after_waiting : Ghost.t finset)
  requires (Finset.subset before_pub after_pub
    && Finset.subset before_links after_links
    && Finset.subset before_seen after_seen
    && Finset.subset before_waiting after_waiting)
  ensures (Set.subset
    (facts_of before_pub before_links before_seen before_waiting)
    (facts_of after_pub after_links after_seen after_waiting)) = ()

lemma issue_fact (q : t) (published : node Atomic.t finset)
    (links : edge finset) (seen : node Atomic.t finset)
    (waiting : Ghost.t finset) (f : fact)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting))))
  requires (Set.mem f (facts_of published links seen waiting))
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton f)))) =
  Ghost.fpu (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting)))
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton f)))

lemma observe_fact (q : t) (published : node Atomic.t finset)
    (links : edge finset) (seen : node Atomic.t finset)
    (waiting : Ghost.t finset) (f : fact)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton f))))
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton f))))
  ensures (Set.mem f (facts_of published links seen waiting)) = ()

lemma is_queue_published_snapshot (q : t) (published : node Atomic.t finset)
    (links : edge finset) (seen : node Atomic.t finset)
    (waiting : Ghost.t finset) (cell : node Atomic.t)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting))))
  requires (Finset.mem cell published)
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Published cell))))) =
  published_fact published links seen waiting cell;
  issue_fact q published links seen waiting (Published cell)

lemma is_queue_published_observe (q : t) (cell : node Atomic.t)
    (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Published cell)))))
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Published cell)))))
  ensures (Finset.mem cell published) =
  observe_fact q published links seen waiting (Published cell)

lemma is_queue_link_snapshot (q : t) (published : node Atomic.t finset)
    (links : edge finset) (seen : node Atomic.t finset)
    (waiting : Ghost.t finset) (link : edge)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting))))
  requires (Finset.mem link links)
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Linked link))))) =
  linked_fact published links seen waiting link;
  issue_fact q published links seen waiting (Linked link)

lemma is_queue_link_observe (q : t) (link : edge)
    (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Linked link)))))
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Linked link)))))
  ensures (Finset.mem link links) =
  observe_fact q published links seen waiting (Linked link)

lemma is_queue_head_snapshot (q : t) (published : node Atomic.t finset)
    (links : edge finset) (seen : node Atomic.t finset)
    (waiting : Ghost.t finset) (cell : node Atomic.t)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting))))
  requires (Finset.mem cell seen)
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Head_seen cell))))) =
  head_fact published links seen waiting cell;
  issue_fact q published links seen waiting (Head_seen cell)

lemma is_queue_head_observe (q : t) (cell : node Atomic.t)
    (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Head_seen cell)))))
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Head_seen cell)))))
  ensures (Finset.mem cell seen) =
  observe_fact q published links seen waiting (Head_seen cell)

lemma is_queue_registration_snapshot (q : t)
    (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset) (reg : Ghost.t)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting))))
  requires (Finset.mem reg waiting)
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Registered reg))))) =
  registration_fact published links seen waiting reg;
  issue_fact q published links seen waiting (Registered reg)

lemma is_queue_registration_observe (q : t) (reg : Ghost.t)
    (published : node Atomic.t finset) (links : edge finset)
    (seen : node Atomic.t finset) (waiting : Ghost.t finset)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Registered reg)))))
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth_frag (Facts.set (facts_of published links seen waiting))
      (Facts.set (Set.singleton (Registered reg)))))
  ensures (Finset.mem reg waiting) =
  observe_fact q published links seen waiting (Registered reg)

lemma is_queue_fact_link (q : t) (published : node Atomic.t finset)
    (links : edge finset) (seen : node Atomic.t finset)
    (waiting : Ghost.t finset) (old_last : node Atomic.t)
    (value : int) (new_last : node Atomic.t)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting))))
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.full (Facts.set
      (facts_of (Finset.union published (Finset.singleton new_last))
        (Finset.union links (Finset.singleton (Edge (old_last, value, new_last))))
        seen waiting)))) =
  facts_grow published (Finset.union published (Finset.singleton new_last))
    links (Finset.union links (Finset.singleton (Edge (old_last, value, new_last))))
    seen seen waiting waiting;
  Ghost.fpu (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting)))
    (Fact_auth.full (Facts.set
      (facts_of (Finset.union published (Finset.singleton new_last))
        (Finset.union links (Finset.singleton (Edge (old_last, value, new_last))))
        seen waiting)))

lemma is_queue_fact_pop (q : t) (published : node Atomic.t finset)
    (links : edge finset) (seen : node Atomic.t finset)
    (waiting : Ghost.t finset) (new_head : node Atomic.t)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting))))
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.full (Facts.set
      (facts_of published links (Finset.union seen (Finset.singleton new_head))
        waiting)))) =
  facts_grow published published links links seen
    (Finset.union seen (Finset.singleton new_head)) waiting waiting;
  Ghost.fpu (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting)))
    (Fact_auth.full (Facts.set
      (facts_of published links (Finset.union seen (Finset.singleton new_head))
        waiting)))

lemma is_queue_fact_register (q : t) (published : node Atomic.t finset)
    (links : edge finset) (seen : node Atomic.t finset)
    (waiting : Ghost.t finset) (reg : Ghost.t)
  requires (own (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting))))
  ensures (own (Ghost.at facts_auth q.head)
    (Fact_auth.full (Facts.set
      (facts_of published links seen (Finset.union waiting (Finset.singleton reg)))))) =
  facts_grow published published links links seen seen waiting
    (Finset.union waiting (Finset.singleton reg));
  Ghost.fpu (Ghost.at facts_auth q.head)
    (Fact_auth.auth (Facts.set (facts_of published links seen waiting)))
    (Fact_auth.full (Facts.set
      (facts_of published links seen (Finset.union waiting (Finset.singleton reg)))))

let waiting_watched : (Ghost.t, node Atomic.t) Ghost.field = Ghost.field ()
let waiting_linked : (Ghost.t, bool) Ghost.field = Ghost.field ()
let waiting_token : (Ghost.t, Empty.token) Ghost.field = Ghost.field ()
let waiting_retired : (Ghost.t, bool) Ghost.field = Ghost.field ()

predicate waiting_registration (reg : Ghost.t) (q : t) =
  exists token : Empty.token, linked : bool, retired : bool.
    own ~fraction:Permission.half (Ghost.at waiting_token reg) token
    && own ~fraction:Permission.half (Ghost.at waiting_linked reg) linked
    && own ~fraction:Permission.half (Ghost.at waiting_retired reg) retired
    && (if retired then true
        else if linked then Empty.committed token q false
        else Empty.pending token q)

predicate queue (q : t) (xs [@implicit] : int list) =
  own ~fraction:Permission.half (Ghost.at view_queue q.head) xs

invariant is_queue (q : t) =
  exists root : node Atomic.t, head : node Atomic.t,
    last : node Atomic.t, tail : node Atomic.t,
    retired_values : int list, values : int list,
    retired_fp : node Atomic.t finset, active_fp : node Atomic.t finset,
    retired_links : edge finset, active_links : edge finset,
    waiting : Ghost.t finset, waiting_on : (Ghost.t, node Atomic.t) map.
    q.head != q.tail
    && own q.head head
    && own q.tail tail
    && segment root head retired_values retired_fp retired_links
    && segment head last values active_fp active_links
    && own last Nil
    && Finset.inter retired_fp active_fp = Finset.empty
    && not (Finset.mem last retired_fp)
    && not (Finset.mem last active_fp)
    && Finset.mem tail
         (Finset.union retired_fp
           (Finset.union active_fp (Finset.singleton last)))
    && (forall reg : Ghost.t.
          Finset.mem reg waiting ->
            own ~fraction:Permission.half (Ghost.at waiting_watched reg)
              (Map.get waiting_on reg)
            && Finset.mem (Map.get waiting_on reg)
                 (Finset.union retired_fp
                   (Finset.union active_fp (Finset.singleton last)))
            && own ~fraction:Permission.half (Ghost.at waiting_linked reg)
                 (Map.get waiting_on reg != last)
            && waiting_registration reg q)
    && own ~fraction:Permission.half (Ghost.at view_queue q.head) values
    && own (Ghost.at facts_auth q.head)
         (Fact_auth.auth (Facts.set
           (facts_of
             (Finset.union retired_fp
               (Finset.union active_fp (Finset.singleton last)))
             (Finset.union retired_links active_links)
             (Finset.union retired_fp (Finset.singleton head)) waiting)))

lemma waiting_help (q : t) (cell : node Atomic.t) (xs : int list)
    (waiting : Ghost.t finset)
    (waiting_on : (Ghost.t, node Atomic.t) map)
    (linkedflags : Ghost.t set)
  requires (xs <> [])
  requires (own ~fraction:Permission.half (Ghost.at view_queue q.head) xs)
  requires (forall reg : Ghost.t.
    Finset.mem reg waiting ->
      own ~fraction:Permission.half (Ghost.at waiting_linked reg)
        (Set.mem reg linkedflags)
      && waiting_registration reg q
      && (Map.get waiting_on reg == cell -> not (Set.mem reg linkedflags)))
  ensures (own ~fraction:Permission.half (Ghost.at view_queue q.head) xs)
  ensures (forall reg : Ghost.t.
    Finset.mem reg waiting ->
      own ~fraction:Permission.half (Ghost.at waiting_linked reg)
        (Set.mem reg linkedflags || Map.get waiting_on reg == cell)
      && waiting_registration reg q)
  variant (waiting) =
  if waiting <> Finset.empty then begin
    let reg = Finset.choose waiting in
    let rest = Finset.diff waiting (Finset.singleton reg) in
    waiting_help q cell xs rest waiting_on linkedflags;
    if Map.get waiting_on reg == cell then begin
      let (token, linked, retired) =
        unfold waiting_registration reg q {token; linked; retired} in
      if not retired then begin
        let observed = Empty.access token q in
        unfold queue q observed;
        assert (observed = xs);
        assert (observed <> []);
        fold queue q observed;
        Empty.commit token q false
      end else ();
      Ghost.write (Ghost.at waiting_linked reg) true;
      fold waiting_registration reg q
        {token = token; linked = true; retired = retired}
    end else ()
  end else ()

lemma segment_excludes_owned (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
    (other : node Atomic.t) (other_value : node)
  requires (segment first limit items cells edges && own other other_value)
  ensures (segment first limit items cells edges && own other other_value)
  ensures (not (Finset.mem other cells))
  variant (items) =
  let (next, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  match items with
  | [] -> fold segment first limit items cells edges
  | _ :: tail ->
      assert (first != other);
      segment_excludes_owned next limit tail tail_cells tail_edges other other_value;
      fold segment first limit items cells edges
        {next = next; tail_cells = tail_cells; tail_edges = tail_edges}

lemma segment_prepend (first : node Atomic.t) (limit : node Atomic.t)
    (value : int) (items : int list) (next [@implicit] : node Atomic.t)
    (cells [@implicit] : node Atomic.t finset) (edges [@implicit] : edge finset)
  requires (own first (Next (value, next)) && own limit Nil
    && segment next limit items cells edges)
  ensures (own limit Nil && segment first limit (value :: items)
    (Finset.union (Finset.singleton first) cells)
    (Finset.union (Finset.singleton (Edge (first, value, next))) edges)) =
  segment_info next limit items cells edges;
  segment_excludes_owned next limit items cells edges first (Next (value, next));
  assert (first != limit);
  fold segment first limit (value :: items)
    (Finset.union (Finset.singleton first) cells)
    (Finset.union (Finset.singleton (Edge (first, value, next))) edges)
    {next = next; tail_cells = cells; tail_edges = edges}

lemma initialize_built_queue (q : t) (last : node Atomic.t) (values : int list)
    (root [@implicit] : node Atomic.t) (cells [@implicit] : node Atomic.t finset)
    (edges [@implicit] : edge finset)
  requires (own q.head root && own q.tail last && own last Nil
    && segment root last values cells edges
    && own (Ghost.at view_queue q.head) values
    && own (Ghost.at facts_auth q.head) (Fact_auth.full (Facts.set Set.empty)))
  ensures (is_queue q && queue q values) =
  assert (q.head != q.tail);
  segment_info root last values cells edges;
  fold queue q values;
  fold segment root root [] Finset.empty Finset.empty;
  Ghost.fpu (Ghost.at facts_auth q.head)
    (Fact_auth.full (Facts.set Set.empty))
    (Fact_auth.full (Facts.set
      (facts_of (Finset.union cells (Finset.singleton last)) edges
        (Finset.singleton root) Finset.empty)));
  fold is_queue q {root = root; head = root; last = last; tail = last;
    retired_values = []; values = values; retired_fp = Finset.empty; active_fp = cells;
    retired_links = Finset.empty; active_links = edges; waiting = Finset.empty;
    waiting_on = (Map.const last : (Ghost.t, node Atomic.t) map)}
