module Cell : Ghost.MutexResource with type t = bool ref = struct
  type t = bool ref
  predicate resource (cell : t) = exists value : bool. own cell.contents value
end
module Guard = Ghost.Mutex (Cell)

proof result = spurious_guard mutex condition cell
  requires (Ghost.Mutex.context owner held && not (Finset.mem mutex held) &&
    Guard.is_mutex mutex cell && Guard.is_condition condition mutex)
  ensures (Guard.is_mutex mutex cell && Guard.is_condition condition mutex && result) =
  at (Mutex.lock mutex) (fun lock ->
    let result = lock () in
    unfold Cell.resource cell;
    result);
  at (Condition.wait condition mutex) (fun invoke ->
    fold Cell.resource cell;
    let result = invoke () in
    unfold Cell.resource cell;
    result);
  at (Mutex.unlock mutex) (fun unlock ->
    fold Cell.resource cell;
    let result = unlock () in result)
