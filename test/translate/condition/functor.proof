module Worker (A : Element) = struct
  module Resource : Ghost.MutexResource with type t = A.t = struct
    type t = A.t
    predicate resource (value : t) = true
  end
  module Guard = Ghost.Mutex (Resource)

  proof result = create value
    ensures (match result with mutex, condition ->
      Guard.is_mutex mutex value && Guard.is_condition condition mutex) =
    at (Mutex.create ()) (fun create ->
      fold Resource.resource value;
      let mutex = create () in
      Guard.initialize mutex value;
      mutex);
    at (Condition.create ()) (fun create ->
      let condition = create () in
      Guard.initialize_condition condition mutex;
      condition)

  proof result = work mutex condition value
    requires (Ghost.Mutex.context self held &&
      not (Finset.mem mutex held) && Guard.is_mutex mutex value &&
      Guard.is_condition condition mutex)
    ensures (Guard.is_mutex mutex value && Guard.is_condition condition mutex &&
      result === value) = ()
  module Job = Ghost.Task (struct let operation = work end)

  proof domain = launch mutex condition value
    requires (Guard.is_mutex mutex value && Guard.is_condition condition mutex)
    ensures (Job.handle domain mutex condition value) = ()

  proof result = finish domain mutex condition value
    requires (Job.handle domain mutex condition value)
    ensures (Guard.is_mutex mutex value && Guard.is_condition condition mutex &&
      result === value) = ()
end

proof result = client () ensures (result === 8) = ()
