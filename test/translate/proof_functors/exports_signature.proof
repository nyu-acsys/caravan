module Make (Cell : CELL) = struct
  predicate wrapped (cell : t) (n [@implicit] : int) =
    exists same : t. same === cell && Cell.counter same n

  lemma preserve (cell : t) (n [@implicit] : int)
    requires (wrapped cell n)
    ensures (wrapped cell n) =
    let same = unfold wrapped cell n { same } in
    fold wrapped cell n { same = same }
end

lemma keep (cell : Alias.t) (n [@implicit] : int)
  requires (Alias.wrapped cell n)
  ensures (Sealed.wrapped cell n) = ()

lemma open_roundtrip (cell : Open.t) (n [@implicit] : int)
  requires (Open.wrapped cell n)
  ensures (Open.wrapped cell n) =
  Open.preserve cell;
  let same = unfold Open.wrapped cell n { same } in
  fold Open.wrapped cell n { same = same }
