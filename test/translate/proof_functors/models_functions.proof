module Make (Cell : CELL) = struct
  let same (cell : Cell.t) : Cell.t = cell

  let twice (cell : Cell.t) : Cell.t = same (same cell)

  lemma identity (cell : Cell.t) ensures (twice cell === cell) = ()
end

lemma alias (cell : Actual.First.t)
  ensures (First.twice cell === Alias.same cell) =
  First.identity cell

lemma second (cell : Actual.Second.t)
  ensures (Second.twice cell === cell) =
  Second.identity cell
