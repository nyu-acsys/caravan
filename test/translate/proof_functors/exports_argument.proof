module Make (Cell : CELL) = struct
  predicate wrapped (cell : t) (n [@implicit] : int) =
    exists same : t. same === cell && Cell.counter same n

  lemma preserve (cell : t) (n [@implicit] : int)
    requires (wrapped cell n)
    ensures (wrapped cell n) =
    let same = unfold wrapped cell n { same } in
    fold wrapped cell n { same = same }
end

lemma third_roundtrip (cell : Input.t) (n [@implicit] : int)
  requires (Third.wrapped cell n)
  ensures (Third.wrapped cell n) =
  Third.preserve cell;
  let same = unfold Third.wrapped cell n { same } in
  fold Third.wrapped cell n { same = same }
