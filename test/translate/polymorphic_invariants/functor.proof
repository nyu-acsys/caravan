module Make (P : PARAM) = struct
  type 'a state = { value : 'a }

  invariant is_cell (q : 'a t) (s : 'a state) = own q.cell s.value

  view cell (q : 'a t) = s.value

  action replace value = compare_and_set q.cell _ value
    ~> { s with value = value } linearizes set
end

module Fresh () = struct
  type 'a state = { value : 'a }

  invariant is_cell (q : 'a t) (s : 'a state) = own q.cell s.value

  view cell (q : 'a t) = s.value

  action replace value = compare_and_set q.cell _ value
    ~> { s with value = value } linearizes set
end
