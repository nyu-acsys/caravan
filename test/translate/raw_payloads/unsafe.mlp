module Payload = Ghost.Relaxed (struct let field (cell : 'a cell) = cell.value end)
proof result = unchecked cell requires (Payload.state cell current writes) = ()
proof result = copied cell requires (Payload.state cell current writes) = ()
proof result = boolean cell requires (Payload.state cell current writes) = ()
proof result = arithmetic cell requires (Payload.state cell current writes) = ()
proof result = aggregate cell requires (Payload.state cell current writes) = ()
proof result = call cell requires (Payload.state cell current writes) = ()
proof result = capture cell requires (Payload.state cell current writes) = ()
proof result = destructure cell requires (Payload.state cell current writes) = ()
proof result = pattern cell requires (Payload.state cell current writes) = ()
