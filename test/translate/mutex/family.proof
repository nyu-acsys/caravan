module Resource : Ghost.MutexResource with type 'a t = 'a t = struct
  type nonrec 'a t = 'a t
  predicate resource (cell : 'a t) = exists value : 'a. own cell.value value
end
module Guard = Ghost.Mutex(Resource)

lemma fields (cell : 'a t) (mutex [@implicit] : Mutex.t)
    (condition [@implicit] : Condition.t)
  returns (saved_mutex : Mutex.t) (saved_condition : Condition.t)
  requires (own cell.mutex mutex && own cell.condition condition)
  ensures (own cell.mutex mutex && own cell.condition condition &&
    saved_mutex === mutex && saved_condition === condition) = (mutex, condition)

predicate [@inline] handle (cell : 'a t) (mutex : Mutex.t) (condition : Condition.t) =
  own cell.mutex mutex && own cell.condition condition &&
  Guard.is_mutex mutex cell && Guard.is_condition condition mutex

proof result, [mutex : Mutex.t], [condition : Condition.t] = create value
  requires (Ghost.Mutex.context owner held)
  ensures (handle result mutex condition && not (Finset.mem mutex held)) =
  on return Ghost.returns (fun result () ->
    let (mutex, condition) = fields result in
    fold Resource.resource result;
    Guard.initialize mutex result;
    Guard.initialize_condition condition mutex;
    (mutex, condition))

proof await [mutex : Mutex.t] [condition : Condition.t] cell
  requires (handle cell mutex condition && Ghost.Mutex.context owner held &&
    not (Finset.mem mutex held))
  ensures (handle cell mutex condition) = ()

proof client () ensures (true) =
  let first_handles = at (let first = create 17) (fun invoke ->
    let (result, handles) = invoke () in (result, handles)) in
  let second_handles = at (let second = create true) (fun invoke ->
    let (result, handles) = invoke () in (result, handles)) in
  at (await first) (fun invoke ->
    let (mutex, condition) = first_handles in
    let result = invoke (mutex, condition) in result);
  at (await second) (fun invoke ->
    let (mutex, condition) = second_handles in
    let result = invoke (mutex, condition) in result)
