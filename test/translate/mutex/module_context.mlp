module Resource : Ghost.MutexResource with type t = unit = struct
  type t = unit
  predicate resource (value : t) = true
end
module Guard = Ghost.Mutex (Resource)

module Actual = struct
  predicate contents (cell : int Atomic.t) (value [@implicit] : int) = own cell value
  proof acquire mutex
    requires (Ghost.Mutex.context self held && not (Finset.mem mutex held) && Guard.is_mutex mutex ())
    ensures (Ghost.Mutex.context self (Finset.union held (Finset.singleton mutex)) &&
      Guard.is_mutex mutex () && Guard.held mutex self && Resource.resource ()) = ()

  proof release mutex
    requires (Ghost.Mutex.context self held && Finset.mem mutex held &&
      Guard.is_mutex mutex () && Guard.held mutex self && Resource.resource ())
    ensures (Ghost.Mutex.context self (Finset.diff held (Finset.singleton mutex)) && Guard.is_mutex mutex ()) = ()

  proof check () requires (Ghost.Mutex.context self held) ensures (true) = ()

  proof read = at (Atomic.get cell) commit

end

proof result = client () ensures (result === 14) =
  at (Mutex.create ()) (fun create ->
    fold Resource.resource ();
    let mutex = create () in
    Guard.initialize mutex ();
    mutex);
  at (First.run mutex cell) (fun run ->
    fold Actual.contents cell 7;
    let result = run () in
    result)
