type edge = Edge of node Atomic.t * int * node Atomic.t

predicate segment (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset) =
  not (Finset.mem limit cells)
  && (match items with
      | [] -> first = limit && cells = Finset.empty && edges = Finset.empty
      | value :: tail ->
          exists next : node Atomic.t, tail_cells : node Atomic.t finset,
            tail_edges : edge finset.
          first <> limit && not (Finset.mem first tail_cells)
          && cells = Finset.union (Finset.singleton first) tail_cells
          && edges = Finset.union (Finset.singleton (Edge (first, value, next))) tail_edges
          && own first (Next (value, next))
          && segment next limit tail tail_cells tail_edges)

lemma segment_info (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
  requires (segment first limit items cells edges)
  ensures (segment first limit items cells edges)
  ensures (not (Finset.mem limit cells))
  ensures (items = [] -> first = limit && cells = Finset.empty && edges = Finset.empty)
  ensures (items <> [] -> Finset.mem first cells && first <> limit) =
  let (next, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  fold segment first limit items cells edges {next = next; tail_cells = tail_cells;
    tail_edges = tail_edges}

lemma segment_join (first : node Atomic.t) (middle : node Atomic.t)
    (limit : node Atomic.t) (left : int list) (right : int list)
    (left_cells : node Atomic.t finset) (right_cells : node Atomic.t finset)
    (left_edges : edge finset) (right_edges : edge finset)
  requires (segment first middle left left_cells left_edges
    && segment middle limit right right_cells right_edges)
  requires (Finset.inter left_cells right_cells = Finset.empty)
  requires (not (Finset.mem limit left_cells))
  ensures (segment first limit (left @ right)
    (Finset.union left_cells right_cells) (Finset.union left_edges right_edges))
  variant (left) =
  segment_info middle limit right right_cells right_edges;
  let (next, tail_cells, tail_edges) =
    unfold segment first middle left left_cells left_edges {next; tail_cells; tail_edges} in
  match left with
  | [] -> ()
  | value :: tail ->
      segment_join next middle limit tail right tail_cells right_cells tail_edges right_edges;
      fold segment first limit (left @ right)
        (Finset.union left_cells right_cells) (Finset.union left_edges right_edges)
        {next = next; tail_cells = Finset.union tail_cells right_cells;
          tail_edges = Finset.union tail_edges right_edges}

lemma segment_append (first : node Atomic.t) (limit : node Atomic.t)
    (successor : node Atomic.t) (items : int list)
    (cells : node Atomic.t finset) (edges : edge finset) (value : int)
  requires (segment first limit items cells edges && own limit (Next (value, successor)))
  requires (successor <> limit && not (Finset.mem successor cells))
  ensures (segment first successor (items @ [value])
    (Finset.union cells (Finset.singleton limit))
    (Finset.union edges (Finset.singleton (Edge (limit, value, successor))))) =
  segment_info first limit items cells edges;
  fold segment successor successor [] Finset.empty Finset.empty;
  fold segment limit successor [value] (Finset.singleton limit)
    (Finset.singleton (Edge (limit, value, successor)))
    {next = successor; tail_cells = Finset.empty; tail_edges = Finset.empty};
  segment_join first limit successor items [value] cells (Finset.singleton limit)
    edges (Finset.singleton (Edge (limit, value, successor)))

lemma segment_split (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
    (target : node Atomic.t)
  returns (before : int list) (before_cells : node Atomic.t finset)
    (before_edges : edge finset) (value : int) (next : node Atomic.t)
    (after : int list) (after_cells : node Atomic.t finset) (after_edges : edge finset)
  requires (segment first limit items cells edges && Finset.mem target cells)
  ensures (segment first target before before_cells before_edges
    && own target (Next (value, next)) && segment next limit after after_cells after_edges)
  ensures (items = before @ (value :: after))
  ensures (cells = Finset.union before_cells (Finset.union (Finset.singleton target) after_cells))
  ensures (edges = Finset.union before_edges
    (Finset.union (Finset.singleton (Edge (target, value, next))) after_edges))
  ensures (Finset.inter before_cells after_cells = Finset.empty)
  ensures (not (Finset.mem target before_cells) && not (Finset.mem target after_cells))
  ensures (target <> limit && not (Finset.mem limit before_cells))
  variant (items) =
  let (successor, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  match items with
  | [] -> assert false
  | head :: tail ->
      if first = target then begin
        fold segment first target [] Finset.empty Finset.empty;
        ([], Finset.empty, Finset.empty, head, successor, tail, tail_cells, tail_edges)
      end else begin
        let (prefix, prefix_cells, prefix_edges, value, next, after, after_cells, after_edges) =
          segment_split successor limit tail tail_cells tail_edges target in
        fold segment first target (head :: prefix)
          (Finset.union (Finset.singleton first) prefix_cells)
          (Finset.union (Finset.singleton (Edge (first, head, successor))) prefix_edges)
          {next = successor; tail_cells = prefix_cells; tail_edges = prefix_edges};
        (head :: prefix, Finset.union (Finset.singleton first) prefix_cells,
          Finset.union (Finset.singleton (Edge (first, head, successor))) prefix_edges,
          value, next, after, after_cells, after_edges)
      end

lemma segment_restore (first : node Atomic.t) (target : node Atomic.t)
    (next : node Atomic.t) (limit : node Atomic.t) (before : int list) (after : int list)
    (before_cells : node Atomic.t finset) (after_cells : node Atomic.t finset)
    (before_edges : edge finset) (after_edges : edge finset) (value : int)
  requires (segment first target before before_cells before_edges
    && own target (Next (value, next)) && segment next limit after after_cells after_edges)
  requires (Finset.inter before_cells after_cells = Finset.empty
    && not (Finset.mem target before_cells) && not (Finset.mem target after_cells)
    && not (Finset.mem limit before_cells) && target <> limit)
  ensures (segment first limit (before @ (value :: after))
    (Finset.union before_cells (Finset.union (Finset.singleton target) after_cells))
    (Finset.union before_edges
      (Finset.union (Finset.singleton (Edge (target, value, next))) after_edges))) =
  segment_info next limit after after_cells after_edges;
  fold segment target limit (value :: after)
    (Finset.union (Finset.singleton target) after_cells)
    (Finset.union (Finset.singleton (Edge (target, value, next))) after_edges)
    {next = next; tail_cells = after_cells; tail_edges = after_edges};
  segment_join first target limit before (value :: after) before_cells
    (Finset.union (Finset.singleton target) after_cells) before_edges
    (Finset.union (Finset.singleton (Edge (target, value, next))) after_edges)

lemma segment_round_trip (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
    (target : node Atomic.t)
  requires (segment first limit items cells edges && Finset.mem target cells)
  ensures (segment first limit items cells edges) =
  let (before, before_cells, before_edges, value, next, after, after_cells, after_edges) =
    segment_split first limit items cells edges target in
  segment_restore first target next limit before after before_cells after_cells
    before_edges after_edges value

lemma segment_edge_endpoints (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
  requires (segment first limit items cells edges)
  ensures (segment first limit items cells edges)
  ensures (forall edge : edge. Finset.mem edge edges ->
    match edge with Edge (source, _, destination) ->
      Finset.mem source cells && (Finset.mem destination cells || destination = limit))
  variant (items) =
  let (next, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  match items with
  | [] -> fold segment first limit items cells edges
  | _ :: tail ->
      segment_info next limit tail tail_cells tail_edges;
      segment_edge_endpoints next limit tail tail_cells tail_edges;
      fold segment first limit items cells edges {next = next; tail_cells = tail_cells;
        tail_edges = tail_edges}

lemma segment_edges_functional (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
  requires (segment first limit items cells edges)
  ensures (segment first limit items cells edges)
  ensures (forall a : edge, b : edge. Finset.mem a edges && Finset.mem b edges ->
    match a with Edge (source_a, _, _) ->
      match b with Edge (source_b, _, _) -> source_a = source_b -> a = b)
  variant (items) =
  let (next, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  match items with
  | [] -> fold segment first limit items cells edges
  | _ :: tail ->
      segment_edge_endpoints next limit tail tail_cells tail_edges;
      segment_edges_functional next limit tail tail_cells tail_edges;
      fold segment first limit items cells edges {next = next; tail_cells = tail_cells;
        tail_edges = tail_edges}

lemma segment_terminal_outside (first : node Atomic.t) (limit : node Atomic.t)
    (items : int list) (cells : node Atomic.t finset) (edges : edge finset)
    (terminal : node Atomic.t)
  requires (segment first limit items cells edges && own terminal End)
  ensures (segment first limit items cells edges && own terminal End)
  ensures (not (Finset.mem terminal cells))
  variant (items) =
  let (next, tail_cells, tail_edges) =
    unfold segment first limit items cells edges {next; tail_cells; tail_edges} in
  match items with
  | [] -> fold segment first limit items cells edges
  | _ :: tail ->
      assert (first <> terminal);
      segment_terminal_outside next limit tail tail_cells tail_edges terminal;
      fold segment first limit items cells edges {next = next; tail_cells = tail_cells;
        tail_edges = tail_edges}

lemma consecutive_segment_edges (first : node Atomic.t) (middle : node Atomic.t)
    (limit : node Atomic.t) (left : int list) (right : int list)
    (left_cells : node Atomic.t finset) (right_cells : node Atomic.t finset)
    (left_edges : edge finset) (right_edges : edge finset)
  requires (segment first middle left left_cells left_edges
    && segment middle limit right right_cells right_edges)
  requires (Finset.inter left_cells right_cells = Finset.empty)
  ensures (segment first middle left left_cells left_edges
    && segment middle limit right right_cells right_edges)
  ensures (forall a : edge, b : edge.
    Finset.mem a (Finset.union left_edges right_edges)
    && Finset.mem b (Finset.union left_edges right_edges) ->
      match a with Edge (source_a, _, _) ->
        match b with Edge (source_b, _, _) -> source_a = source_b -> a = b)
  ensures (forall edge : edge. Finset.mem edge (Finset.union left_edges right_edges) ->
    match edge with Edge (source, _, destination) ->
      Finset.mem source (Finset.union left_cells right_cells)
      && (Finset.mem destination (Finset.union left_cells right_cells)
        || destination = middle || destination = limit)) =
  segment_edge_endpoints first middle left left_cells left_edges;
  segment_edge_endpoints middle limit right right_cells right_edges;
  segment_edges_functional first middle left left_cells left_edges;
  segment_edges_functional middle limit right right_cells right_edges

lemma list_append_assoc (a : int list) (b : int list) (c : int list)
  ensures ((a @ b) @ c = a @ (b @ c))
  variant (a) =
  match a with
  | [] -> ()
  | _ :: tail -> list_append_assoc tail b c
