predicate contents (node : ('a, [ `Node ]) node) (value [@implicit] : 'a) =
  match node with Node cell -> own cell value

module Read = Ghost.AU (struct let operation = read_as end)
module Reader = Ghost.Task (struct let operation = read end)

type 'a saved =
  | Saved_value of ('a, 'a) Read.token
  | Saved_option of ('a, 'a option) Read.token

lemma preserve_value (node : ('a, [ `Node ]) node)
    (token : ('a, 'a) Read.token) (value : 'a)
  requires (Read.committed token node Value value)
  ensures (Read.committed token node Value value) = ()

proof result = atomic read_as node kind
  atomic requires (contents node value)
  atomic ensures (contents node value && match kind with
    | Value -> result === value
    | Option -> result === Some value) =
  at (Atomic.get cell) (fun step ->
    let token = Read.bind () in
    let value = Read.access token node kind in
    unfold contents node value;
    let result = step () in
    fold contents node value;
    begin match kind with
    | Value ->
        Read.commit token node kind result;
        preserve_value node token result
    | Option -> Read.commit token node kind (Some result)
    end;
    result)

proof result = read node
  requires (contents node value)
  ensures (contents node value && result === value) =
  at (Atomic.get cell) (fun step ->
    unfold contents node value;
    let result = step () in
    fold contents node value;
    result)
