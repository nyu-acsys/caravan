predicate contents (cell : int Atomic.t) (value [@implicit] : int) = own cell value

module Read = Ghost.AU (struct let operation = read end)
module ReadRetry = Ghost.AU (struct let operation = read_retry end)
module Write = Ghost.AU (struct let operation = write end)

lemma bounce (token : Read.token) (cell : int Atomic.t)
  requires (Read.pending token cell)
  ensures (Read.pending token cell) =
  let value = Read.access token cell in
  Read.abort token cell

module Resource : Ghost.MutexResource with type t = int Atomic.t = struct
  type t = int Atomic.t
  predicate resource (cell : t) = true
end
module Guard = Ghost.Mutex (Resource)
