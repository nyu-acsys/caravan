module R = Excl (struct type t = int end)
type state = { value : int [@grows] }

invariant is_counter (c : t) (s : state) =
  0 <= s.value && s.value <= 1 && own c s.value

view model (c : t) = (if s.value = 0 then R.invalid else R.excl 1)
view other (c : t) = (if s.value = 0 then R.excl 2 else R.excl 3)

action set_one = compare_and_set c 0 1 ~> { s with value = s.value + 1 } linearizes set_one
