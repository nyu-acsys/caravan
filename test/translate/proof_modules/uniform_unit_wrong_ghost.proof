module World = struct
  module Make () = struct
    type model = Empty | Item of int

    let payload (value : model) : int =
      match value with Empty -> 0 | Item value -> value

    let slot : (Ghost.t, int) Ghost.field = Ghost.field ()
    predicate held (cell : Ghost.t) (value : int) = own (Ghost.at slot cell) value

    lemma allocate returns (cell : Ghost.t)
      ensures (held cell 0) =
      let cell = Ghost.alloc [Ghost.init slot 0] in
      fold held cell 0;
      cell
  end

  lemma wrong (cell : Ghost.t)
    requires (One.held cell 0)
    ensures (Two.held cell 0) = ()
end
