module Make (X : INPUT) = struct
  type state = { cells : t sequence [@grows] }

  lemma empty_cells (ignored : unit) returns (cells : t list)
    ensures (cells === []) = []

  invariant live (root : t) (s : state) =
    own root 0
    && (forall i : integer. 0 <= i && i < length s.cells -> own s.cells.(i) 0)
end
