(copy_files ../../saturn/michael_scott_queue/michael_scott_queue_intf.mli)

(copy_files
 ../../saturn/michael_scott_queue_lseg/michael_scott_queue_lseg_intf.mli)

(rule
 (target history_queue.ml)
 (deps
  ../../saturn/michael_scott_queue/michael_scott_queue.ml
  ../../saturn/michael_scott_queue/michael_scott_queue.mli
  ../module_ms_queue/client.ml
  clients.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "module Make () : sig\n")
    (cat ../../saturn/michael_scott_queue/michael_scott_queue.mli)
    (echo "\nend = struct\n")
    (cat ../../saturn/michael_scott_queue/michael_scott_queue.ml)
    (echo
     "\nend\n\nmodule First = Make ()\nmodule Second = Make ()\nmodule Alias = First\n\n")
    (cat ../module_ms_queue/client.ml)
    (echo "\n")
    (cat clients.ml)))))

