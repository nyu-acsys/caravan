proc invent_release_view(executing: Ref, flag: Ref, other: Ref, channel: Ref)
  requires ThreadContext.context(executing, {})
    && ThreadCounters.published(other, flag, 1, {}) && channel != other
  opens ThreadCounters.published, ThreadContext.released
{
  // The publication certificate binds the release view to {}, not {channel}.
  val result := ThreadCounters.acquire(executing, other, flag, {}, 1, {channel});
}
